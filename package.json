{
  "name": "@eeko/sdk",
  "version": "0.9.0",
  "description": "Official SDK for building Eeko widgets and overlays",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./payloads": {
      "types": "./dist/payloads/index.d.ts",
      "import": "./dist/payloads/index.js"
    },
    "./template": {
      "types": "./dist/template/index.d.ts",
      "import": "./dist/template/index.js"
    },
    "./template/node": {
      "types": "./dist/template/node.d.ts",
      "import": "./dist/template/node.js"
    },
    "./interactions": {
      "types": "./dist/interactions/index.d.ts",
      "import": "./dist/interactions/index.js"
    },
    "./runtime-bridge": {
      "types": "./dist/runtime-bridge.d.ts",
      "import": "./dist/runtime-bridge.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "check:version": "node -e \"const p=require('./package.json');const fs=require('fs');const m=fs.readFileSync('./src/index.ts','utf8').match(/VERSION\\s*=\\s*'([^']+)'/);if(!m||m[1]!==p.version){console.error('VERSION constant',m&&m[1],'does not match package.json',p.version);process.exit(1)}console.log('version ok',p.version)\"",
    "prepublishOnly": "npm run check:version && npm run build"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "happy-dom": "^20.10.2",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.7"
  },
  "keywords": [
    "eeko",
    "streaming",
    "overlay",
    "widget",
    "sdk",
    "twitch",
    "youtube",
    "kick",
    "tiktok"
  ],
  "author": "Eeko",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EekoBot/sdk.git"
  },
  "bugs": {
    "url": "https://github.com/EekoBot/sdk/issues"
  },
  "homepage": "https://github.com/EekoBot/sdk#readme",
  "publishConfig": {
    "access": "public"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}
